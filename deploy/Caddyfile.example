# Generic Caddy site for the hosted Bakbak MCP server, for a host where Caddy
# terminates TLS itself, in front of the container on 127.0.0.1:8080.
# Replace mcp.example.com and set MCP_PUBLIC_URL=https://mcp.example.com.

mcp.example.com {
	# Behind Cloudflare: believe CF-Connecting-IP only from Cloudflare's
	# addresses (https://www.cloudflare.com/ips/). Delete this block if the
	# site is not proxied by Cloudflare.
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @not_cloudflare -CF-Connecting-IP

	request_body {
		max_size 1MB
	}

	reverse_proxy 127.0.0.1:8080 {
		# MCP answers with Server-Sent Events: pass every byte through at once.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output file /var/log/caddy/mcp.access.log
		format filter {
			request>headers>Authorization delete
			request>headers>X-Api-Key delete
			request>headers>Cookie delete
			request>headers>Cf-Connecting-Ip delete
			wrap json
		}
	}
}
