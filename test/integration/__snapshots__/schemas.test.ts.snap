          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "voice_id": {
          "type": "string",
        },
      },
      "required": [
        "audio_url",
        "expires_at",
        "format",
        "duration_seconds",
        "characters",
        "voice_id",
        "model",
        "language",
        "request_ids",
      ],
      "type": "object",
    },
    "title": "Text to speech",
  },
  {
    "_meta": undefined,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "List voices",
    },
    "description": "List Bakbak voices, optionally filtered by language, model and a name substring. Free: uses no credits. Each voice has an id (pass it to text_to_speech as voice_id), a name, a language and a model (pass it as model).",
    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "enum": [
                "hi",
                "mr",
                "te",
                "kn",
                "bn",
                "as",
                "gu",
                "ne",
                "ml",
                "ta",
                "pa",
                "en",
                "en-in",
                "en-us",
              ],
              "type": "string",
            },
            {
              "minLength": 1,
              "type": "string",
            },
          ],
          "description": "Only voices for this language, e.g. hi.",
        },
        "limit": {
          "default": 50,
          "description": "Maximum number of voices to return (default 50).",
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "model": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "m1",
              ],
              "type": "string",
            },
            {
              "minLength": 1,
              "type": "string",
            },
          ],
          "description": "Only voices of this model: standard or m1.",
        },
        "query": {
          "description": "Only voices whose name contains this text (case-insensitive).",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "list_voices",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "count": {
          "description": "Voices returned.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "total": {
          "description": "Voices matching the filters, before the limit.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "voices": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
              },
              "language": {
                "type": "string",
              },
