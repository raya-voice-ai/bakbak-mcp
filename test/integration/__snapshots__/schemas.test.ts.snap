[
  {
    "_meta": undefined,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Text to speech",
    },
    "description": "Convert text to natural speech with Bakbak and return a download link for the audio (valid for one hour). Uses Bakbak credits for every character, so call it once per text and do not retry a success. Pick a voice for the language with list_voices first and pass its id as voice_id and its model as model (a voice works only with its own model). Hindi text must be in Devanagari script. Text up to 50,000 characters; long text is split at sentence boundaries and joined into one file.",
    "execution": undefined,
    "icons": undefined,
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "include_audio": {
          "default": false,
          "description": "Also return the audio inline as an audio content block. Only for audio up to 1 MB (about 20 s of the default WAV).",
          "type": "boolean",
        },
        "language": {
          "anyOf": [
            {
              "enum": [
                "hi",
                "mr",
                "te",
                "kn",
                "bn",
                "as",
                "gu",
                "ne",
                "ml",
                "ta",
                "pa",
                "en",
                "en-in",
                "en-us",
              ],
              "type": "string",
            },
            {
              "minLength": 1,
              "type": "string",
            },
          ],
          "description": "Language of the text: hi, mr, te, kn, bn, as, gu, ne, ml, ta, pa, en, en-in or en-us. m1 voices use en.",
        },
        "model": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "m1",
              ],
              "type": "string",
            },
            {
              "minLength": 1,
              "type": "string",
            },
          ],
          "description": "standard or m1. Must be the voice's model; if omitted, the chosen voice's own model is used.",
        },
        "output_format": {
          "additionalProperties": false,
          "description": "The API output_format object. Default {"container":"wav","encoding":"pcm_s16le","sample_rate":24000}.",
          "properties": {
            "container": {
              "anyOf": [
                {
                  "enum": [
                    "wav",
                    "mp3",
                    "raw",
                  ],
                  "type": "string",
                },
                {
                  "minLength": 1,
                  "type": "string",
                },
              ],
              "description": "wav (default), mp3, or raw (headerless samples).",
            },
            "encoding": {
              "anyOf": [
                {
                  "enum": [
                    "pcm_s16le",
                    "pcm_f32le",
                    "pcm_mulaw",
                    "pcm_alaw",
                  ],
                  "type": "string",
                },
                {
                  "minLength": 1,
                  "type": "string",
                },
              ],
              "description": "Sample encoding. Required for wav and raw; omit for mp3.",
            },
            "sample_rate": {
              "description": "Samples per second: 8000, 16000, 22050 or 24000 (the default).",
              "type": "number",
            },
          },
          "required": [
            "container",
          ],
          "type": "object",
        },
        "speed": {
          "description": "Speaking rate from 0.5 to 1.5 (default 1.0).",
          "type": "number",
        },
        "text": {
          "description": "The text to speak, up to 50,000 characters. Hindi must be in Devanagari script; Indian names in English text are best written in Devanagari.",
          "maxLength": 50000,
          "minLength": 1,
          "type": "string",
        },
        "voice_id": {
          "description": "A voice id from list_voices. If omitted, the first voice for the language (and model, if given) is used.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "text",
        "language",
      ],
      "type": "object",
    },
    "name": "text_to_speech",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "audio_url": {
          "description": "Download link for the audio. Private; anyone with the link can download it until it expires.",
          "type": "string",
        },
        "characters": {
          "description": "Characters of text synthesized (code points).",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "duration_seconds": {
          "description": "Length of the audio in seconds.",
          "type": "number",
        },
        "expires_at": {
          "description": "When the link stops working (ISO 8601, UTC).",
          "type": "string",
        },
        "format": {
          "additionalProperties": false,
          "properties": {
            "container": {
              "type": "string",
            },
            "encoding": {
              "type": "string",
            },
            "mime_type": {
              "type": "string",
            },
            "sample_rate": {
              "type": "number",
            },
          },
          "required": [
            "container",
            "mime_type",
          ],
          "type": "object",
        },
        "language": {
          "type": "string",
        },
        "model": {
